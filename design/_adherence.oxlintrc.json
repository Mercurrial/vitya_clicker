      "--type-price-size",
      "--type-price-weight",
      "--type-stat-size",
      "--type-stat-weight",
      "--type-tab-size",
      "--type-tab-tracking",
      "--type-tab-weight",
      "--type-tier-size",
      "--type-tier-tracking",
      "--type-tier-weight",
      "--void"
    ],
    "tokenKinds": {
      "--font-ui": "font",
      "--font-mono": "font",
      "--type-tier-size": "font",
      "--type-tier-weight": "font",
      "--type-tier-tracking": "font",
      "--type-hero-size": "font",
      "--type-hero-weight": "font",
      "--type-hero-tracking": "font",
      "--type-stat-size": "font",
      "--type-stat-weight": "font",
      "--type-tab-size": "font",
      "--type-tab-weight": "font",
      "--type-tab-tracking": "font",
      "--type-name-size": "font",
      "--type-name-weight": "font",
      "--type-desc-size": "font",
      "--type-desc-weight": "font",
      "--type-price-size": "font",
      "--type-price-weight": "font",
      "--void": "color",
      "--surface-1": "color",
      "--surface-2": "color",
      "--surface-3": "color",
      "--accent": "color",
      "--accent-dim": "color",
      "--accent-glow": "color",
      "--cta": "color",
