      "--glass-bg": "color",
      "--glass-blur": "other",
      "--glass-border": "color",
      "--glass-inset": "spacing",
      "--hairline": "color",
      "--space-1": "spacing",
      "--space-2": "spacing",
      "--space-3": "spacing",
      "--space-4": "spacing",
      "--space-5": "spacing",
