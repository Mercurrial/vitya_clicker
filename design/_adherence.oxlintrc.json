{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/game/**",
              "ui_kits/kardashev/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|tone|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: icon, value, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|mid)$/]",
        "message": "<Chip> tone must be one of 'accent' | 'mid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Core'] > JSXAttribute > JSXIdentifier[name!=/^(?:pressed|size|children|key|ref|className|style|children)$/]",
        "message": "<Core> doesn't accept that prop. Declared props: pressed, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GeneratorRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|name|count|rate|price|affordable|locked|highlighted|onBuy|key|ref|className|style|children)$/]",
        "message": "<GeneratorRow> doesn't accept that prop. Declared props: glyph, name, count, rate, price, affordable, locked, highlighted, onBuy."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|tint|key|ref|className|style|children)$/]",
        "message": "<Glyph> doesn't accept that prop. Declared props: name, size, tint."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlyphTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|active|size|key|ref|className|style|children)$/]",
        "message": "<GlyphTile> doesn't accept that prop. Declared props: name, active, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|active|onChange|key|ref|className|style|children)$/]",
        "message": "<SegmentedTabs> doesn't accept that prop. Declared props: tabs, active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='UpgradeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:glyph|title|desc|price|state|onBuy|key|ref|className|style|children)$/]",
        "message": "<UpgradeCard> doesn't accept that prop. Declared props: glyph, title, desc, price, state, onBuy."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "Chip": {
        "replaces": []
      },
      "Core": {
        "replaces": []
      },
      "GeneratorRow": {
        "replaces": []
      },
      "Glyph": {
        "replaces": []
      },
      "GlyphTile": {
        "replaces": []
      },
      "ProgressBar": {
        "replaces": []
      },
      "SegmentedTabs": {
        "replaces": []
      },
      "UpgradeCard": {
        "replaces": []
      }
    },
    "tokens": [
      "--accent",
      "--accent-dim",
      "--accent-glow",
      "--core-glow-idle",
      "--core-glow-press",
      "--cta",
      "--cta-glow",
