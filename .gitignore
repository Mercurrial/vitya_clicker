/android/app/debug
/android/app/profile
/android/app/release

# Готовая сборка для раздачи — лежит рядом с проектом, в репозиторий не едет.
*.apk

# Отчёты о расхождении снимков — мусор от упавшего голден-теста.
test/failures/

# Claude Code.
# Worktree-сессии приложение создаёт внутри проекта; без этой строки
# `git add -A` в основной копии затянул бы их в коммит вложенными репозиториями.
.claude/worktrees/
# Личные разрешения — у каждой машины свои. В git они конфликтовали бы
# при каждом переходе с компьютера на компьютер.
.claude/settings.local.json
