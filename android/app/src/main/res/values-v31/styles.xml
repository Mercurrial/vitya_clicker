<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Начиная с Android 12 системная заставка рисуется сама и windowBackground
         на неё не влияет. Без этих двух строк друг увидит белый круг с иконкой
         перед тёмным гаражом. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/garage_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/garage_bg</item>
    </style>
</resources>
