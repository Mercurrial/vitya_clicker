<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Игра всегда тёмная, поэтому светлой темы нет ни здесь, ни в
         values-night: оба варианта одинаковые. Иначе при выключенной тёмной
         теме системы запуск моргал бы белым. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Заставка. Снимается автоматически, когда Flutter рисует первый кадр. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Тема окна после старта процесса: видна позади интерфейса, пока Flutter
         инициализируется. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/garage_bg</item>
    </style>
</resources>
